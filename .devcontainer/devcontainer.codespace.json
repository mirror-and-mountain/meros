{
  "name": "MEROS THEME CODESPACE",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/var/www/html",
  "remoteUser": "www-data",
  "remoteEnv": {
    "WP_THEME_NAME": "meros-blocks",
    "VSCODE_SERVER_HOME": "/home/www-data/.vscode-server"
  },
  "postCreateCommand": "bash -c 'set -x; load-environment.sh && setup-wp.sh'",
  "forwardPorts": [
    80
  ],
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql",
        "bmewburn.vscode-intelephense-client",
        "laravel.vscode-laravel",
        "wordpresstoolbox.wordpress-toolbox",
        "neilbrayfield.php-docblocker",
        "bradlc.vscode-tailwindcss"
      ]
    },
    "codespaces": {
      "repositories": {
        "mirror-and-mountain/*": {
          "permissions": "write-all"
        }
      }
    }
  }
}