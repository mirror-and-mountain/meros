{
  "name": "MEROS",
  "dockerComposeFile": "docker-compose.yml",
  "service": "wordpress",
  "workspaceFolder": "/var/www/html/wp-content/themes/${localWorkspaceFolderBasename}",
  "remoteUser": "www-data",
  "remoteEnv": {
    "VSCODE_SERVER_HOME": "/home/www-data/.vscode-server",
    "WP_TESTS_DIR": "/home/www-data/meros-testing/wordpress-develop/tests/phpunit",
    "WP_TESTS_ROOT": "/home/www-data/meros-testing/wordpress-develop/src",
    "MEROS_TEST_DB_NAME": "meros_tests",
    "MEROS_TEST_DB_HOST": "test-db",
    "MEROS_TEST_DB_USER": "root",
    "MEROS_TEST_DB_PASSWORD": ""
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/var/www/html/wp-content/themes/${localWorkspaceFolderBasename},type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/keys,target=/home/www-data/keys,type=bind,consistency=cached"
  ],
  "postCreateCommand": "set -x && cd /var/www/html/wp-content/themes/${localWorkspaceFolderBasename} && sleep 5 && composer dump-autoload && sleep 5 && wp meros:install framework --required-only --surpress-env-error",
  "forwardPorts": [
    8000,
    9000,
    1025,
    8025
  ],
  "features": {}
}