{
  "name": "MEROS",
  "dockerComposeFile": "docker-compose.yml",
  "service": "wordpress",
  "workspaceFolder": "/var/www/html/wp-content/themes/${localWorkspaceFolderBasename}",
  "remoteUser": "www-data",
  "remoteEnv": {
    "VSCODE_SERVER_HOME": "/home/www-data/.vscode-server"
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/var/www/html/wp-content/themes/${localWorkspaceFolderBasename},type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/keys,target=/home/www-data/keys,type=bind,consistency=cached"
  ],
  "postCreateCommand": "set -x && cd /var/www/html/wp-content/themes/${localWorkspaceFolderBasename} && sleep 5 && composer dump-autoload && wp meros:install --required-only",
  "forwardPorts": [
    8000,
    9000,
    1025,
    8025
  ],
  "features": {}
}