{
  "name": "MEROS THEME DEV CONTAINER",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/var/www/html/wp-content/themes/${localWorkspaceFolderBasename}",
  "remoteUser": "www-data",
  "remoteEnv": {
    "VSCODE_SERVER_HOME": "/home/www-data/.vscode-server"
  },
  "containerEnv": {
    "WP_THEME_NAME": "${localWorkspaceFolderBasename}"
  },
   "mounts": [
    "source=${localWorkspaceFolder},target=/var/www/html/wp-content/themes/${localWorkspaceFolderBasename},type=bind,consistency=cached"
  ],
  "postCreateCommand": "bash -c 'set -x; load-environment.sh && setup-wp.sh'",
  "forwardPorts": [
    80
  ],
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql",
        "bmewburn.vscode-intelephense-client",
        "laravel.vscode-laravel",
        "wordpresstoolbox.wordpress-toolbox",
        "neilbrayfield.php-docblocker",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}