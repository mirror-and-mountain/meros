# WordPress Site configuration
THEME_SLUG="meros-wp"
SITE_TITLE="Meros WP"

# WordPress Site admin credentials
ADMIN_USER="admin"
ADMIN_PASSWORD="password"
ADMIN_EMAIL="admin@example.com"

# WordPress Database configuration
DB_NAME="wordpress"
DB_HOST="db"
DB_USER="dbuser"
DB_PASSWORD="dbpassword"
DB_ROOT_PASSWORD="rootpassword"
DB_PREFIX="wp_"
DB_CHARSET="utf8mb4"
DB_COLLATE="utf8mb4_unicode_ci"

# Ports configuration
WP_PORT="8000"
PHPMYADMIN_PORT="9000"

# Used for apache user www-data to match host user permissions. 
# Needed for Podman setups only. Defaults to 501 (macOS) if not set.
LOCAL_USER_ID="501"
LOCAL_GROUP_ID="501"

# If using podman for devcontainers, set the following settings in vs code's settings.json:
# "dev.containers.dockerPath": "podman",
# "dev.containers.dockerComposePath": "podman-compose",