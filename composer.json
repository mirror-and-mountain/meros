{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mirror-and-mountain/meros",
    "description": "A block-based starter theme for Wordpress using the Meros Framework",
    "type": "project",
    "license": "MIT",
     "keywords": [
        "meros",
        "wordpress",
        "acorn",
        "laravel",
        "livewire"
    ],
    "authors": [
        {
            "name": "tmw-mm",
            "email": "toby@mirrorandmountain.com"
        }
    ],
    "require": {
        "mirror-and-mountain/meros-framework": "^0.0.4",
        "mirror-and-mountain/meros-crm": "^0.0.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Roots\\Acorn\\ComposerScripts::postAutoloadDump",
            "MM\\Meros\\Scripts\\ComposerScripts::postAutoloadDump"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
